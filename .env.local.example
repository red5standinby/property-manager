# ─── VestaOS env (copy to .env.local) ─────────────────────────────
# Phase 2 backend. Nothing here is required for the local (localStorage)
# prototype — copy this file only when enabling the remote backend.

# Adapter selection: "local" (default, localStorage) or "remote" (API + Supabase).
NEXT_PUBLIC_VESTAOS_BACKEND=local

# API base for the remote adapter. Defaults to /api if unset.
# NEXT_PUBLIC_VESTAOS_API_BASE=/api

# ── Supabase (fill after creating the project) ──
# Project URL + anon key from Supabase → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only service role key (NEVER expose to the browser). Used by
# migration + admin scripts only.
# SUPABASE_SERVICE_ROLE_KEY=
